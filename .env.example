# ==============================================================================
# BATTLE OF THE MAROONS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/battle_of_the_maroons?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://kalharamdw_db_user:RUHZJtW6YxKgT3MW@maroons-cluster.e8khmyi.mongodb.net/battle_of_the_maroons?retryWrites=true&w=majority

# JWT Authentication Secret Key (Used to sign administrator session tokens)
# Generate a strong 64-character random string in production
JWT_SECRET=bom_maroons_centenary_super_secure_jwt_secret_2027_key

# ------------------------------------------------------------------------------
# Sri Lanka Payment Gateway (PayHere)
# Obtain credentials from: https://www.payhere.lk/ (or sandbox: https://sandbox.payhere.lk/)
# ------------------------------------------------------------------------------
PAYHERE_MERCHANT_ID=1220000
PAYHERE_MERCHANT_SECRET=portal_secret_demo
PAYHERE_ENV=sandbox
# Options for PAYHERE_ENV: 'sandbox' (for testing without real money) | 'live' (production)

# ------------------------------------------------------------------------------
# Initial Administrator Setup (Created on first run via `npm run seed`)
# ------------------------------------------------------------------------------
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_EMAIL=admin@battleofthemaroons.lk
ADMIN_INITIAL_PASSWORD=Maroons@2027
